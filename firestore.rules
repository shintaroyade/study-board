rules_version = '2';
// 勉強会アプリ用ルール
// ・予定と勉強会の名前:誰でも見られる(書き込みはログインした人だけ)
// ・メンバー/出欠/文法の進捗:ログインした人だけ
// ・目標メモ・理解度(users/本人のID/...):本人しか読み書きできない
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function small() { return request.resource == null || request.resource.data.size() <= 20; }

    match /events/{id}   { allow read: if true;       allow write: if signedIn() && small(); }
    match /settings/{id} { allow read: if true;       allow write: if signedIn() && id == "app"; }
    match /members/{uid} { allow read: if signedIn(); allow write: if signedIn() && request.auth.uid == uid && small(); }
    match /rsvps/{id}    { allow read: if signedIn(); allow write: if signedIn() && small() && (request.resource == null || request.resource.data.uid == request.auth.uid); }
    match /grammar/{id}  { allow read: if signedIn(); allow write: if signedIn() && id == "progress"; }
    match /users/{uid}/{document=**} { allow read, write: if signedIn() && request.auth.uid == uid; }

    match /{document=**} { allow read, write: if false; }
  }
}
